#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# ./dev — the Kiln developer CLI. One command for the whole loop:
#   ./dev build [rom]        build a ROM (default: hello)
#   ./dev run   <rom>        boot it in Ares
#   ./dev deploy <rom>       upload to a SummerCart64
#   ./dev debug              read debugf() stdio from the cart
#   ./dev check              everything CI runs (the pre-push gate)
#   ./dev doctor             report toolchain / tools / hardware
# Zero deps; auto-enters `nix develop` when the toolchain isn't on PATH.
set -uo pipefail
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$REPO"

usage() {
  cat <<'H'
./dev — the Kiln developer CLI
  build [rom]              nix build .#<rom>            (default: hello)
  shot  <rom> [out] [s]    boot in Ares on Hyprland, screenshot + pixel stats
  rec   <rom> [out] [dur] [--native]
                           boot in Ares on Hyprland, record MP4 (default 60 s,
                           Ares-only audio via PipeWire app routing; out and
                           dur are order-free — a bare number is the duration)
  drive <rom> <script> [outdir]
                           boot in Ares with a uinput virtual pad and run an
                           input script (wait/press/hold/stick/shot)
  pc    [example] [args]   build and RUN the game natively — a real window,
                           keyboard and gamepad, sound. No emulator, no ROM.
                           --frames N / --shot out.png make it scriptable.
  web   [example] [--serve|--verify]
                           build the browser version (wasm32 + canvas + Web
                           Audio). --serve hosts it on :8080; --verify drives
                           it in headless Chromium and asserts it renders,
                           loops and answers the keyboard
  arch  [target]           build and run the host gates for one architecture:
                           native | wasm32 | aarch64 | riscv64 (the last two
                           cross-compile against musl and run under qemu-user)
  run   <rom>              boot the ROM in Ares (never trust an emulator for
                           audio work — the AI clock and RDRAM contention are
                           reconstructed inexactly)
  inspect <rom>            Ares with GDB server + print attach command
  deploy <rom>             sc64deployer upload -> SummerCart64
  debug                    read debugf() stdio from SC64 or ED64
  faust [target]           show a voice's gate output + cycle budget
  bake  [target]           show baked VADPCM assets + reference render
  check                    nix flake check (the pre-push gate)
  cheap                    the fast host gates: geometry, logic, gui, the
                           level vocabulary and the .map path (no ROMs)
  studio [--port N] [--host ADDR]
                           Kiln Studio: every game, builds and checks with live
                           logs, in one local web app (http://localhost:8420)
  cine-lint <shot.json> [--json]
                           validate a camera shot with kiln_camlint (see
                           tools/camlint/camlint.c for the JSON shape)
  doctor [--json]          toolchain, libdragon, cart presence, versions
  new <name> [--in-repo] [--out DIR]
                           start a game from templates/game: a new flake in
                           ./<name> (or DIR), or with --in-repo an example in
                           examples/<name> plus nix/demos/<name>.nix
  mapmaker                 three.js .map editor on :8000/mapmaker/
  map-validate <file.map>  round-trip through quake_map.py (+ --json)
  map-emit <spec.json> [out.map]
                           author a level from JSON, no browser needed
  map-dump <file.map> [out.json]
                           read a level as JSON (round-trips with map-emit)
  map-canon <file.map>     repair inside-out brush winding in place
  map-render <file.map> [out.png]
                           draw a level to a PNG — no ROM, no emulator
  mcp [--build]            the tools/blender-mcp server (agents use .mcp.json)
  browser                  the UI agent's browser tool, selftest only —
                           the MCP server is .mcp.json's kiln-browser
  poser / poser-stage / poser-verify
                           three.js animation editor on :8001/poser/

  Forge — the on-console voxel level editor (.#forge). The flashcart's SD card
  is the transport in BOTH directions, because an ED64 Plus has no USB:
  Jump ROMs boot Forge straight into one mode, which is how a mode reached
  only by a chord gets verified with no controller: nix build .#forge-<mode>
  for geo, walk, paint, ent, light, cam — then ./dev shot forge-cam out.png
  forge-card [mount]       print where the card is mounted (or fail loudly)
  forge-push <file.map> [mount]
                           convert a .map to Forge's working format on the card,
                           so an existing level can be edited on the console
  forge-pull [mount] [name]
                           bring a session back: copies the .FRG, the ROM's own
                           .MAP, the generated light header and the PMCamKey
                           table into assets/, tails FORGE.LOG, and runs the
                           strict validator over the map
Examples:
  ./dev build hello        ./dev run hello        ./dev deploy hello
  ./dev pc                 the engine demo, in a window, right now
  ./dev pc engine-demo --shot f.png --frames 90    scriptable, no window needed
  ./dev web --serve        the same demo in a browser
  ./dev arch riscv64       prove the renderer agrees on another architecture
  ./dev inspect hello      ./dev debug
  ./dev mapmaker                        three.js .map maker on http://localhost:8000/mapmaker/
  ./dev map-validate <file.map>          round-trip through quake_map.py + limits check
  ./dev forge-push assets/oot_test.map     edit an existing level on the console
  ./dev forge-pull                       and bring it back
H
}

case "${1:-help}" in help | -h | --help) usage; exit 0 ;; esac

# ── auto-enter nix develop if the cross toolchain isn't available ────────────
# pc, web and arch are host-tier commands: they build nothing for the N64 and
# have no business pulling in a mips64-elf toolchain to run a program on this
# machine. Everything they need is inside the derivation nix builds for them.
case "${1:-}" in
  pc | web | arch) DEV_IN_NIX=1 ;;
  # The .map tools are python3 and a host binary; none of them builds
  # anything for the N64, so pulling in a mips64-elf toolchain just to
  # reach a `nix run` is pure latency. map-validate used to do exactly
  # that.
  map-validate | map-emit | map-dump | map-canon | map-render | mcp)
    DEV_IN_NIX=1 ;;
  # Scaffolding copies files; the studio is a python server that calls nix.
  # Scaffolding copies files; the studio is a python server that calls nix.
  # browser is the UI agent's selftest — python, builds nothing for the N64.
  new | studio | cine-lint | browser) DEV_IN_NIX=1 ;;
esac

have_toolchain() { command -v mips64-elf-gcc >/dev/null 2>&1 && [ -n "${N64_INST:-}" ]; }
if [ "${DEV_IN_NIX:-}" != 1 ] && ! have_toolchain; then
  export DEV_IN_NIX=1
  exec nix develop --command "$REPO/dev" "$@"
fi

die() { echo "dev: $*" >&2; exit 1; }

# Resolve a ROM name to a .z64 path, building it if needed.
rom_path() {
  local name="${1:-hello}" out
  out="$(nix build --no-link --print-out-paths ".#$name")" || die "build of '$name' failed"
  local z64
  z64="$(find "$out" -maxdepth 1 -name '*.z64' | head -1)"
  [ -n "$z64" ] || die "no .z64 in $out"
  echo "$z64"
}

# ── Where is the flashcart's SD card? ─────────────────────────────────────
# An ED64 Plus has no USB, so the card IS the transport in both directions and
# every forge-* command needs its mount point. Take it as an argument, else
# $FORGE_CARD, else look for a removable mount that already has a FORGE/ dir or
# a forge.z64 on it. Refuse rather than guess: writing a level into the wrong
# directory is silent and the ROM will not find it next boot.
forge_find_card() {
  if [ -n "${1:-}" ]; then
    [ -d "$1" ] || { echo "dev: $1 is not a directory" >&2; return 1; }
    echo "$1"; return 0
  fi
  if [ -n "${FORGE_CARD:-}" ]; then
    [ -d "$FORGE_CARD" ] || { echo "dev: FORGE_CARD=$FORGE_CARD is not a directory" >&2; return 1; }
    echo "$FORGE_CARD"; return 0
  fi
  for base in /run/media/"$USER" /media/"$USER" /mnt; do
    [ -d "$base" ] || continue
    for m in "$base"/*; do
      [ -d "$m" ] || continue
      if [ -d "$m/FORGE" ] || [ -f "$m/forge.z64" ] || [ -f "$m/FORGE.Z64" ]; then
        echo "$m"; return 0
      fi
    done
  done
  echo "dev: could not find the flashcart's SD card." >&2
  echo "     Pass it: ./dev forge-pull /run/media/$USER/ED64" >&2
  echo "     Or export FORGE_CARD=/path/to/card" >&2
  return 1
}


cmd="$1"; shift
case "$cmd" in
  build)
    nix build --print-out-paths ".#${1:-hello}"
    ;;

  pc)
    # A host build, not a ROM: plat/host's software rasteriser drawing into an
    # SDL window. The pixels are the ones nix/checks/ compares against a
    # reference, so this window is evidence about the gated renderer rather
    # than a second one that looks similar.
    # The same --* guard the web case has. usage() advertises
    # `pc [example] [args]` and names --frames/--shot, so `./dev pc --frames 90`
    # is the natural thing to type — and without this it built `.#pc---frames`
    # and reported "add it in flake.nix", which points at the wrong problem.
    ex="engine-demo"
    case "${1:-}" in ""|--*) ;; *) ex="$1"; shift ;; esac
    out="$(nix build --no-link --print-out-paths ".#pc-$ex")" || {
      echo "dev: no .#pc-$ex — add it in flake.nix with hostNative.mkGame" >&2
      exit 1
    }
    bin="$(find "$out/bin" -maxdepth 1 -type f | head -1)"
    echo "dev: $bin"

    # On Hyprland a new window TILES, so a 320x240 game opens by taking half
    # the terminal it was launched from. Float it instead.
    #
    # By PID after the window appears, not by writing a windowrulev2 into the
    # live config: tools/n64-shot.sh established that approach for Ares for
    # the same reason, and a dev command has no business mutating somebody's
    # compositor configuration for the rest of the session. A hand-written
    # `windowrulev2 = float, class:^(kiln)$` also works — the launcher sets
    # that class deliberately.
    if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && command -v hyprctl >/dev/null 2>&1; then
      "$bin" "$@" &
      pid=$!
      # Poll rather than sleep: the window appears when SDL finishes its first
      # frame, which is a different length of time on a cold Nix store.
      for _ in $(seq 1 60); do
        if hyprctl clients -j 2>/dev/null | grep -q "\"pid\": *$pid"; then
          # focuswindow BEFORE centerwindow: centerwindow acts on the
          # ACTIVE window, not on a pid, so without this it would happily
          # centre the terminal you launched from. tools/n64-shot.sh focuses
          # by pid for the same reason. No resize — SDL already picked an
          # integer scale that fits the display, and forcing a size here just
          # fights it and gives you a non-integer scale.
          hyprctl dispatch focuswindow "pid:$pid" >/dev/null 2>&1 || true
          hyprctl dispatch togglefloating "pid:$pid" >/dev/null 2>&1 || true
          hyprctl dispatch centerwindow >/dev/null 2>&1 || true
          break
        fi
        sleep 0.1
      done
      wait "$pid"
      exit $?
    fi

    exec "$bin" "$@"
    ;;

  web)
    ex="${1:-engine-demo}"
    case "$ex" in --*) ex="engine-demo" ;; *) shift || true ;; esac
    out="$(nix build --no-link --print-out-paths ".#web-$ex")" || {
      echo "dev: no .#web-$ex — add it in flake.nix with hostWasm.mkGame" >&2
      exit 1
    }
    page="$(find "$out/bin" -name '*.html' | head -1)"
    echo "dev: $page"
    ls -lh "$out/bin"
    if [ "${1:-}" = "--serve" ] || [ "${2:-}" = "--serve" ]; then
      # A .wasm cannot be fetched over file://, so a local server is not a
      # convenience here — it is the only way to open the page at all.
      dir="$(mktemp -d)"
      # No exec: exec replaces the shell, so the EXIT trap would never fire
      # and every --serve would leave a copy of the wasm behind in /tmp.
      trap 'rm -rf "$dir"' EXIT INT TERM
      cp -L "$out"/bin/* "$dir/"
      mv "$dir/$(basename "$page")" "$dir/index.html"
      echo "dev: http://localhost:8080/  (Ctrl-C to stop)"
      python3 -m http.server 8080 --directory "$dir"
      exit 0
    fi
    if [ "${1:-}" = "--verify" ] || [ "${2:-}" = "--verify" ]; then
      # Headless Chromium over the DevTools protocol. nix/checks/kiln-web.nix
      # already runs the browser launcher under node against a DOM stub, which
      # is what a sandbox with no display can do; this is the part that needs
      # a real browser engine — a real 2D context, real wasm in V8, the actual
      # page, and a keypress that starts in the compositor's event queue.
      #
      # A dev command and not a gate, for the same reason ./dev shot is one:
      # Chromium is a 150 MB dependency, and a pre-push gate has no business
      # pulling it.
      dir="$(mktemp -d)"
      # Kill the children BEFORE removing the directory: chromium is still
      # writing into its profile, so an rm that runs first fails with
      # "Directory not empty" and leaves the profile behind.
      cleanup() {
        [ -n "${chr_pid:-}" ] && kill "$chr_pid" 2>/dev/null
        [ -n "${srv_pid:-}" ] && kill "$srv_pid" 2>/dev/null
        wait 2>/dev/null
        rm -rf "$dir"
      }
      trap cleanup EXIT INT TERM

      cp -L "$out"/bin/* "$dir/"
      mv "$dir/$(basename "$page")" "$dir/index.html"

      # pc/web/arch deliberately skip the nix develop auto-entry, so neither
      # node nor chromium is on PATH. Both are resolved from the PINNED
      # nixpkgs rather than from the host: a verifier that quietly used
      # whatever browser happened to be installed would be reporting about
      # something other than what the flake builds.
      nixpkg() {
        nix build --no-link --print-out-paths --impure \
          --expr "let f = builtins.getFlake (toString \"$REPO\"); \
                  in f.inputs.nixpkgs.legacyPackages.\${builtins.currentSystem}.$1"
      }
      chromium="$(nixpkg chromium)/bin/chromium" || die "could not build chromium"
      node="$(nixpkg nodejs)/bin/node"           || die "could not build nodejs"

      python3 -m http.server 8123 --directory "$dir" >/dev/null 2>&1 &
      srv_pid=$!
      "$chromium" --headless=new --no-sandbox --disable-gpu \
        --remote-debugging-port=9222 --user-data-dir="$dir/profile" \
        --crash-dumps-dir="$dir" about:blank >"$dir/chrome.log" 2>&1 &
      chr_pid=$!
      sleep 3

      "$node" "$REPO/tools/webverify/verify.mjs" http://localhost:8123/ "$dir"
      rc=$?

      # Keep the evidence. A verifier whose screenshots evaporate is one
      # nobody can second-guess, and CLAUDE.md is emphatic that a reference
      # image is only as good as somebody having looked at it.
      shots="$REPO/.webverify"
      rm -rf "$shots" && mkdir -p "$shots"
      cp "$dir"/*.png "$dir"/report.json "$shots/" 2>/dev/null || true
      echo "dev: screenshots and report in $shots"
      exit $rc
    fi
    echo "dev: .wasm will not load over file:// — use ./dev web $ex --serve"
    ;;

  arch)
    t="${1:-native}"
    case "$t" in
      native|wasm32|aarch64|riscv64) ;;
      *) echo "dev: arch must be native, wasm32, aarch64 or riscv64" >&2; exit 1 ;;
    esac
    echo "dev: building and running the host gates for $t"
    echo "dev: the SAME reference images every other architecture is held to —"
    echo "dev: a per-architecture reference would only prove self-consistency."
    nix build --print-out-paths ".#host-arch-$t"
    ;;

  run)
    z64="$(rom_path "${1:-hello}")" || exit 1
    echo "dev: booting $z64 in Ares"
    echo "dev: NOTE — emulators reconstruct the AI clock divider and RDRAM"
    echo "dev:        contention inexactly. Validate audio on hardware."
    nix run .#ares -- "$z64"
    ;;

  inspect)
    rom="${1:-hello}"
    z64="$(rom_path "$rom")" || exit 1

    # Ares mutates its settings file, so use a throwaway config dir.
    cfgdir="$(mktemp -d)"
    trap 'rm -rf "$cfgdir"' EXIT

    # Find the debug ELF produced by mkN64Rom.
    out="$(nix build --no-link --print-out-paths ".#$rom")"
    elf="$(find "$out" -path '*/lib/debug/*.elf' | head -1)"

    echo "dev: launching Ares with GDB server for $rom"
    echo "dev: GDB server on localhost:24689"
    if [ -n "$elf" ]; then
      echo "dev: attach: gdb-multiarch -ex 'target remote :24689' '$elf'"
    else
      echo "dev: no debug ELF found in $out (ROM may not have debug info)"
    fi
    echo "dev: press Ctrl-C in this terminal to stop Ares"

    nix run .#ares -- "$z64" \
        --settings-file "$cfgdir/ares-settings.bml" \
        --setting Boot/Debugger=true \
        --setting Boot/AwaitGDBClient=true \
        --setting DebugServer/Enabled=true \
        --setting DebugServer/Port=24689 \
        --setting DebugServer/UseIPv4=true
    ;;

  shot)
    # Boot the ROM in Ares on the live Hyprland session and capture the window.
    rom="${1:-hello}"; out="${2:-$rom.png}"; settle="${3:-8}"
    z64="$(rom_path "$rom")" || exit 1
    ARES="${ARES:-$(nix build --no-link --print-out-paths .#ares-bin 2>/dev/null)/bin/ares}" \
      bash "$REPO/tools/n64-shot.sh" "$z64" "$out" "$settle" || exit 1

    # Report what actually got rendered. This exists because eyeballing a
    # downscaled screenshot of a 640x240 console on a mostly-black screen is
    # genuinely misleading — it reads as "black" when the text is right there.
    # Pixel counts do not have that failure mode.
    python3 - "$out" <<'PY'
import sys
try:
    from PIL import Image
except ImportError:
    sys.exit("(install pillow for pixel stats)")
from collections import Counter
im = Image.open(sys.argv[1]).convert("RGB")
data = list(im.getdata())
top = Counter(data).most_common(4)
total = len(data)
print("── frame stats ──")
print("  size: %dx%d" % im.size)
for colour, n in top:
    print("  rgb%-16s %6.2f%%" % (str(colour), 100.0 * n / total))
nonblack = sum(n for c, n in Counter(data).items() if sum(c) > 60)
print("  non-black: %.2f%% (%d px)" % (100.0 * nonblack / total, nonblack))
if nonblack < total * 0.0005:
    print("  WARNING: frame is essentially empty — the ROM may not be rendering")
PY
    ;;

  drive)
    # Boot the ROM in Ares with a uinput virtual gamepad and run an input
    # script against it. This is what makes screens behind "press start"
    # reachable at all: a fresh ares config has every binding empty, so
    # without it nothing past the boot splash can ever be captured.
    rom="${1:?usage: ./dev drive <rom> <script.txt> [outdir] [settle]}"
    script="${2:?usage: ./dev drive <rom> <script.txt> [outdir] [settle]}"
    outdir="${3:-$rom-shots}"
    # 3 s, not `shot`'s 8: the first thing intro.txt captures is the boot
    # splash, which is over 3.8 s after the ROM starts.
    settle="${4:-3}"
    z64="$(rom_path "$rom")" || exit 1
    export ARES="${ARES:-$(nix build --no-link --print-out-paths .#ares-bin 2>/dev/null)/bin/ares}"
    bash "$REPO/tools/n64-drive.sh" "$z64" "$script" "$outdir" "$settle" || exit 1
    ;;

  rec)
    # Boot the ROM in Ares on the live Hyprland session and record a clip.
    # Mirrors `shot` above; tools/n64-rec.sh drives gpu-screen-recorder with
    # Ares-only audio (-a app:ares) so other apps playing on the desktop do
    # not bleed into the soundtrack.
    # `./dev rec <rom> [out.mp4] [dur] [--native]`, in any order after the
    # ROM: a bare number is the duration, anything else is the output path.
    # The two used to be strictly positional and the usage text disagreed
    # with the code about which came first, so both orders now work and
    # neither can be silently misread as the other.
    native=0; rom=""; dur=""; out=""
    for a in "$@"; do
      case "$a" in
        --native) native=1 ;;
        *) if   [ -z "$rom" ]; then rom="$a"
           elif [[ "$a" =~ ^[0-9]+([.][0-9]+)?$ ]]; then dur="$a"
           else out="$a"; fi ;;
      esac
    done
    rom="${rom:-cinematic-demo}"; dur="${dur:-60}"; out="${out:-$rom.mp4}"
    z64="$(rom_path "$rom")" || exit 1
    # export, not a command prefix: the prefix form was written with a
    # trailing backslash onto a COMMENT line, which made it a plain shell
    # assignment. ARES then never reached n64-rec.sh's environment and the
    # script silently fell back to whatever `ares` was on PATH — or failed
    # outright when none was.
    export ARES="${ARES:-$(nix build --no-link --print-out-paths .#ares-bin 2>/dev/null)/bin/ares}"
    NATIVE="$native" bash "$REPO/tools/n64-rec.sh" "$z64" "$out" "$dur" || exit 1
    ;;

  deploy)
    z64="$(rom_path "${1:-hello}")" || exit 1
    echo "dev: uploading $z64 to SummerCart64"
    nix run .#sc64 -- upload "$z64"
    ;;

  debug)
    # Auto-detect the connected flashcart by USB VID/PID.
    if lsusb 2>/dev/null | grep -q '0403:6014'; then
      echo "dev: SC64 (0403:6014) detected — reading debugf() stdio (ctrl-c to stop)"
      nix run .#sc64 -- debug
    elif lsusb 2>/dev/null | grep -q '0403:6001'; then
      echo "dev: ED64 (0403:6001) detected — reading debugf() stdio (ctrl-c to stop)"
      nix run .#unfloader -- -d
    else
      echo "dev: no supported flashcart detected (looked for 0403:6014 SC64, 0403:6001 ED64)"
      echo "dev: if a cart is plugged in, ensure nixosModules.n64-flashcart is enabled"
      exit 1
    fi
    ;;

  faust)
    # Compile a live on-console voice and show its gate + budget report.
    name="${1:-ks-voice}"
    out="$(nix build --no-link --print-out-paths ".#$name")" || exit 1
    echo "── undefined symbols (the no-libm gate reads these) ──"
    cat "$out/share/undefined.txt"
    echo "── static cycle budget ──"
    cat "$out/share/budget.txt"
    echo
    echo "object: $out/lib/"
    echo "NOTE: the cycle figure is a static instruction count weighted by the"
    echo "      VR4300 latency table. It models neither cache nor the ~640ns"
    echo "      RDRAM latency. Profile on hardware with TICKS for real numbers."
    ;;

  bake)
    # Render an instrument offline at full quality and VADPCM-encode it.
    name="${1:-ks-baked}"
    out="$(nix build --no-link --print-out-paths ".#$name")" || exit 1
    echo "── baked assets (drop into a ROM via mkN64Rom's \`assets\`) ──"
    ls -l "$out/filesystem/"
    echo "── full-quality reference render (golden A/B source) ──"
    ls -l "$out/share/"
    ;;

  cheap)
    # The fast loops. Not `flake check`: that builds every demo ROM.
    # Host/gui/logic/python only — safe on the laptop. The list lives in the
    # flake (studioCheapChecks), so Kiln Studio runs the same set.
    SYS="$(nix eval --raw --impure --expr builtins.currentSystem)"
    mapfile -t CHEAP < <(nix eval --raw ".#studioManifest.${SYS}.cheap" \
      --apply 'l: builtins.concatStringsSep "\n" l')
    [ "${#CHEAP[@]}" -gt 0 ] || die "studioManifest.${SYS}.cheap is empty"
    nix build --print-out-paths "${CHEAP[@]/#/.#checks.${SYS}.}"
    ;;

  check)
    nix flake check --print-build-logs
    ;;

  mapmaker)
    # Launch the three.js .map maker (tools/mapmaker/) on http://localhost:8000/mapmaker/.
    # Dev-only — outside the hermetic build, same split as tools/blender-mcp/.
    echo "dev: ctrl-c to stop. Inside ./dev studio the same editor saves in place."
    echo "     export with the button; then ./dev map-validate <file.map>"
    echo "     no browser? ./dev map-emit authors the same format from JSON."
    nix run .#mapmaker
    ;;

  poser)
    # Launch the three.js animation editor (tools/poser/) on :8001.
    # Dev-only, same split as mapmaker and tools/blender-mcp/.
    nix run .#poser
    ;;
  poser-stage)
    # Rebuild the models the poser loads and re-dump their source keyframes.
    ./tools/poser/stage.sh "$@"
    ;;
  poser-verify)
    # Prove the editor's Euler convention against Blender's own export.
    nix run .#poser-verify -- "$@"
    ;;
  map-validate)
    # Round-trip a .map through quake_map.py's pure-Python CSG + report counts
    # vs. the engine's limits. Run after exporting from the map maker.
    nix run .#map-validate -- "$@"
    ;;

  map-emit)
    # Author a level from a JSON spec. `./dev map-emit - out.map` reads stdin.
    # Self-validating: it will not write a .map that map-validate would reject.
    nix run .#mapgen -- emit "$@"
    ;;

  map-dump)
    # Read a level as JSON — the same shape map-emit takes, so dump | edit |
    # emit is a round trip.
    nix run .#mapgen -- dump "$@"
    ;;

  mcp)
    # tools/blender-mcp/'s and tools/agents/browser_mcp.py's MCP servers.
    # Agents reach them through .mcp.json at the repo root, which runs
    # `nix run .#blender-mcp` / `.#browser-mcp` DIRECTLY and never through
    # this script: dev auto-execs `nix develop`, whose shellHook echoes a banner
    # to stdout, and stdout is the JSON-RPC channel. That corrupts the stream
    # before the first initialize reply, and presents as a generic "server
    # failed to connect" with nothing to diagnose.
    #
    # --build pre-warms the closures. A cold python3.withPackages [mcp] build can
    # outrun the client's startup timeout, which looks like the same failure.
    if [ "${1:-}" = "--build" ]; then
      # Both are APPs, not packages, so there is no derivation to `nix build`.
      # Running each with stdin already at EOF builds the closure and exits —
      # the warm-up we want. (browser-mcp exits 2 without a studio token;
      # that is expected here.)
      echo "dev: warming the MCP closures..." >&2
      nix run .#blender-mcp </dev/null >/dev/null 2>&1
      nix run .#browser-mcp </dev/null >/dev/null 2>&1 || true
      echo "dev: MCP closures are warm"
      exit 0
    fi
    echo "dev: running the MCP server on stdio (ctrl-c to stop)." >&2
    echo "     agents reach it via .mcp.json; this is for smoke-testing." >&2
    nix run .#blender-mcp
    ;;

  browser)
    # The UI agent's browser tool, selftest only (no Chromium needed). The MCP
    # server itself is .mcp.json's kiln-browser — see the mcp case above for why
    # agents never reach it through this script.
    exec nix run "$REPO#browser-mcp" -- --selftest "$@"
    ;;

  map-render)
    # Draw a level with the real engine and the real kiln_map.c, to a PNG, with
    # no ROM and no compositor. `./dev shot` needs Ares on a live Hyprland
    # session; this needs nothing. Prints the same pixel statistics ./dev shot
    # does, from the same code, so a host render and a console capture read
    # alike — and trust those numbers, not your eyes (see CLAUDE.md).
    nix run .#map-render -- "$@"
    ;;

  map-canon)
    # Repair a .map's brush winding in place. A brush wound inward loads fine
    # on console (kiln_map.c only takes min/max of the plane points) and yields
    # ZERO geometry through quake_map.py's CSG, so this failure is invisible
    # exactly where people look. Reports which reduction each brush needed.
    nix run .#mapgen -- canon "$@"
    ;;

  forge-card)
    # Where is the flashcart's SD card mounted? Everything below needs it, and
    # guessing is how you write a level into $HOME.
    forge_find_card "${1:-}"
    ;;

  forge-push)
    # Put a .map onto the card as a Forge working file, so an existing level can
    # be EDITED on the console. This is what makes Forge a tool for the game that
    # exists rather than only for new content.
    #
    #   ./dev forge-push assets/oot_test.map [/run/media/you/ED64]
    src="${1:?usage: dev forge-push <file.map> [card-mount]}"
    card="$(forge_find_card "${2:-}")" || exit 1
    mkdir -p "$card/FORGE"
    # frommap WARNS on anything off the 32-unit block grid rather than silently
    # rounding it, because a wall that moves half a metre during an import is the
    # kind of change noticed three sessions later. Warnings go to stderr and do
    # not stop the push; read them.
    python3 "$REPO/tools/forge/frg.py" frommap "$src" "$card/FORGE/LEVEL.FRG"
    echo "pushed $src -> $card/FORGE/LEVEL.FRG"
    # forge_find_card already looks for forge.z64 as a card marker, so printing
    # "put the ROM on too" unconditionally was advice the script could see was
    # unnecessary.
    if [ ! -f "$card/forge.z64" ] && [ ! -f "$card/FORGE.Z64" ]; then
      echo "the card has no forge.z64 yet:"
      echo "  nix build .#forge && cp -L result/forge.z64 \"$card/\""
    fi
    ;;

  forge-pull)
    # Bring a session off the card and into the tree. The ROM has already written
    # the .MAP as plain text in the dialect this repo pins, so this is a copy plus
    # the strict validator — not a decoder. That is the whole reason forge_io.c
    # emits ASCII.
    #
    #   ./dev forge-pull [card-mount] [dest-name]
    card="$(forge_find_card "${1:-}")" || exit 1
    name="${2:-forge_level}"
    dir="$card/FORGE"

    # This writes four files into assets/ and used to do it silently. The
    # default name is shared by every pull, so a second session with no
    # explicit name overwrote the first without a word. Say so; --force skips.
    if [ "${FORGE_PULL_FORCE:-}" != 1 ]; then
      for ext in frg map; do
        if [ -e "$REPO/assets/$name.$ext" ]; then
          echo "dev: assets/$name.$ext already exists and will be overwritten." >&2
          echo "     Pass a name:  ./dev forge-pull \"$card\" my_level" >&2
          echo "     Or force it:  FORGE_PULL_FORCE=1 ./dev forge-pull ..." >&2
          exit 1
        fi
      done
    fi
    [ -d "$dir" ] || { echo "dev: no FORGE/ on $card — has the ROM saved yet?" >&2; exit 1; }

    echo "── on the card ──"
    ls -la "$dir"
    echo

    if [ -f "$dir/LEVEL.FRG" ]; then
      cp "$dir/LEVEL.FRG" "$REPO/assets/$name.frg"
      python3 "$REPO/tools/forge/frg.py" info "$REPO/assets/$name.frg"
    else
      echo "dev: no LEVEL.FRG — nothing was saved" >&2
      exit 1
    fi

    # Prefer the ROM's own .MAP. Fall back to re-deriving it from the .FRG, which
    # is what happens on the save-chip backend where text cannot be written —
    # and SAY which one it was, because the two agreeing is a property worth
    # noticing and their disagreeing is worth investigating.
    if [ -f "$dir/LEVEL.MAP" ]; then
      cp "$dir/LEVEL.MAP" "$REPO/assets/$name.map"
      echo "map: taken from the ROM's own emit"
      check_map="$(mktemp -t forge_check.XXXXXX.map)"
      trap 'rm -f "$check_map"' EXIT
      python3 "$REPO/tools/forge/frg.py" tomap "$REPO/assets/$name.frg" "$check_map"
      if diff -q "$check_map" "$REPO/assets/$name.map" >/dev/null 2>&1; then
        echo "map: ROM emit and host mirror agree byte for byte"
      else
        echo "map: NOTE the ROM's emit differs from the host mirror" >&2
        diff -u "$check_map" "$REPO/assets/$name.map" | head -20 >&2 || true
      fi
    else
      python3 "$REPO/tools/forge/frg.py" tomap "$REPO/assets/$name.frg" "$REPO/assets/$name.map"
      echo "map: re-derived on the host (the ROM could not write text)"
    fi

    # The derived text artifacts. Each is optional: a level with no camera path
    # has no .KEY, and a save on the SRAM fallback has none of them at all
    # (kiln_store_write_text is SD-only). Absent is normal, so it is reported
    # rather than treated as an error.
    if [ -f "$dir/LEVEL.H" ]; then
      cp "$dir/LEVEL.H" "$REPO/assets/${name}_light.h"
      echo "light: assets/${name}_light.h"
    else
      echo "light: none on the card"
    fi
    if [ -f "$dir/LEVEL.KEY" ]; then
      cp "$dir/LEVEL.KEY" "$REPO/assets/${name}_keys.h"
      echo "cam:   assets/${name}_keys.h ($(grep -c '^    {' "$dir/LEVEL.KEY") keys)"
      echo "       paste the table into the shot's own .c — it is already"
      echo "       validated by kiln_camlint, the same module Forge's CAM mode runs live"
    else
      echo "cam:   none on the card (no keys, or the validator refused them —"
      echo "       check FORGE.LOG below)"
    fi

    [ -f "$dir/FORGE.LOG" ] && { echo; echo "── FORGE.LOG (tail) ──"; tail -20 "$dir/FORGE.LOG"; }

    echo
    echo "── validate ──"
    nix run .#map-validate -- "$REPO/assets/$name.map"
    echo
    echo "wrote assets/$name.frg and assets/$name.map"
    echo "git diff assets/$name.map to review the change."
    ;;

  studio)
    KILN_REPO="$REPO" exec nix run "$REPO#studio" -- "$@"
    ;;

  cine-lint)
    # kiln_camlint on a shot file: `./dev cine-lint shot.json [--json]`.
    [ $# -ge 1 ] || die "usage: ./dev cine-lint <shot.json> [--json]"
    exec nix run "$REPO#camlint" -- "$@"
    ;;

  new)
    # The dispatcher has already shifted the command name off.
    name="" in_repo=0 outdir=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --in-repo) in_repo=1 ;;
        --out) shift; outdir="${1:-}" ;;
        -*) die "new: unknown option $1" ;;
        *) [ -z "$name" ] || die "new: one name only"; name="$1" ;;
      esac
      shift
    done
    [ -n "$name" ] || die "usage: ./dev new <name> [--in-repo] [--out DIR]"
    # A package attribute, a directory and a .z64 file name all at once.
    [[ "$name" =~ ^[a-z][a-z0-9-]{0,30}$ ]] || die "new: name must be lowercase letters, digits and -, starting with a letter"
    # The ROM header title: 20 ASCII characters, from the name.
    title="$(echo "$name" | tr '-' ' ' | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) substr($i,2)} 1')"
    title="${title:0:20}"
    tpl="$REPO/templates/game"
    subst() { sed -e "s/mygame/$name/g" -e "s/My Game/$title/g" -e "s/MY GAME/${title^^}/g" "$1"; }

    if [ "$in_repo" = 1 ]; then
      dest="$REPO/examples/$name"
      [ ! -e "$dest" ] || die "new: $dest already exists"
      [ ! -e "$REPO/nix/demos/$name.nix" ] || die "new: nix/demos/$name.nix already exists"
      mkdir -p "$dest"
      subst "$tpl/mygame/Makefile" > "$dest/Makefile"
      subst "$tpl/mygame/main.c" > "$dest/main.c"
      cat > "$REPO/nix/demos/$name.nix" <<NIX
# SPDX-License-Identifier: MIT
#
# $name — created by \`./dev new $name --in-repo\`. Add jump ROMs with
# mkJumpRoms and a host build with hostNative.mkGame; see nix/demos/README.md.
ctx: with ctx;
{
  $name = mkN64Rom {
    name = "$name";
    src = ../../examples/$name;
    romTitle = "$title";
  };
}
NIX
      # Flakes only see files git knows about.
      git -C "$REPO" add -N "examples/$name" "nix/demos/$name.nix"
      echo "created examples/$name and nix/demos/$name.nix"
      echo "  nix build .#$name        ./dev run $name"
    else
      dest="${outdir:-$PWD/$name}"
      [ ! -e "$dest" ] || die "new: $dest already exists"
      mkdir -p "$dest/$name"
      subst "$tpl/flake.nix" > "$dest/flake.nix"
      subst "$tpl/game.nix" > "$dest/game.nix"
      subst "$tpl/.gitignore" > "$dest/.gitignore"
      subst "$tpl/mygame/Makefile" > "$dest/$name/Makefile"
      subst "$tpl/mygame/main.c" > "$dest/$name/main.c"
      git -C "$dest" init -q && git -C "$dest" add -A
      echo "created $dest"
      echo "  cd $dest && nix build && nix run github:ALH477/kiln#ares -- result/$name.z64"
    fi
    ;;

  doctor)
    if [ "${1:-}" = "--json" ]; then
      # Machine-readable, for Kiln Studio's capability detection. Presence
      # only; the human form below says what to do about an absence.
      jbool() { if eval "$1" >/dev/null 2>&1; then echo true; else echo false; fi; }
      tools=""
      for t in n64tool mkdfs audioconv64 n64sym; do
        tools="$tools\"$t\":$(jbool "[ -x \"\${N64_INST:-}/bin/$t\" ]"),"
      done
      printf '{"system":"%s","nix":"%s","toolchain":%s,"libdragon":{%s},' \
        "$(nix eval --raw --impure --expr builtins.currentSystem 2>/dev/null)" \
        "$(nix --version 2>/dev/null | awk '{print $NF}')" \
        "$(jbool 'command -v mips64-elf-gcc')" "${tools%,}"
      printf '"hyprland":%s,"grim":%s,"ares":%s,"sc64":%s,"ed64":%s,"blender":%s,"chromium":%s,"tailscale":%s}\n' \
        "$(jbool '[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && command -v hyprctl')" \
        "$(jbool 'command -v grim')" \
        "$(jbool 'command -v ares')" \
        "$(jbool 'lsusb | grep -qi 0403:6014')" \
        "$(jbool 'lsusb | grep -qi 0403:6001')" \
        "$(jbool 'command -v blender')" \
        "$(jbool 'command -v chromium')" \
        "$(jbool 'command -v tailscale')"
      exit 0
    fi
    echo "── toolchain ──"
    if command -v mips64-elf-gcc >/dev/null 2>&1; then
      mips64-elf-gcc --version | head -1
      echo "  target: $(mips64-elf-gcc -dumpmachine)"
    else
      echo "  MISSING (run inside 'nix develop')"
    fi
    echo "── libdragon ──"
    echo "  N64_INST=${N64_INST:-<unset>}"
    for t in n64tool mkdfs audioconv64 n64sym; do
      if [ -x "${N64_INST:-}/bin/$t" ]; then echo "  $t: ok"; else echo "  $t: MISSING"; fi
    done
    echo "── hardware ──"
    if lsusb 2>/dev/null | grep -qi '0403:6014'; then
      echo "  SummerCart64 (FT232H 0403:6014): present"
    else
      echo "  SummerCart64: not detected"
    fi
    if lsusb 2>/dev/null | grep -qi '0403:6001'; then
      echo "  ED64 (FT245R 0403:6001): present"
    else
      echo "  ED64: not detected"
    fi
    echo "  (if a cart is plugged in, you likely need nixosModules.n64-flashcart)"
    ;;


  *)
    echo "dev: unknown command '$cmd'" >&2
    usage
    exit 1
    ;;
esac
