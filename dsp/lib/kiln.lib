// SPDX-License-Identifier: MIT
//
// kiln.lib — the primitives the Kiln instrument library is built from.
//
//     kl = library("kiln.lib");
//
// ── Why this exists and is not just stdfaust.lib ───────────────────────
// A live voice (nix/faust.nix, mkFaustVoice) fails `nix build` if its object
// calls libm. Most of stdfaust's oscillators and filters do, not in the
// per-sample path but in the constructor: os.osc fills a table with sinf()
// at init, fi.svf and fi.lowpass call tanf() to place a cutoff, and
// ba.tau2pole calls expf(). The symbol gate reads the whole object, so "only
// at init" is still a build failure — and it should be, because init runs
// on the same 93.75 MHz CPU.
//
// Every definition here is arithmetic, comparison, integer cast and
// no.noise's integer LCG. That is the entire vocabulary, and it is what lets
// the SAME .dsp be baked on the host at full quality and also linked into a
// ROM as a live voice, with one source of truth for both.
//
// The approximations are chosen to be worse than libm by an amount nobody
// can hear and better than the VR4300 can afford:
//
//   psin   parabolic sine with one correction term, |error| < 1.1e-3
//          (about -59 dB of distortion, all of it above the third harmonic)
//   tanx   x + x^3/3 + 2x^5/15 + 17x^7/315, for filter cutoffs up to
//          0.25*SR where it is within 0.3% of tan
//   rate   1 - e^-x taken as its first-order form; exact enough for any
//          envelope longer than ~1 ms and it is the cost of one divide
//
// Written from scratch; nothing here is copied from the Faust libraries.
// The algorithms (PolyBLEP, the topology-preserving SVF, Karplus-Strong,
// Chowning FM) are the textbook ones and are credited where they appear.

import("stdfaust.lib");

// ── time and rate ──────────────────────────────────────────────────────
T = 1.0 / ma.SR;

// Per-sample coefficient for a one-pole that settles (-60 dB) in `x` seconds.
// 6.9078 = ln(1000). Clamped so a very short time is "instantly", not
// unstable.
rate(x) = min(1.0, 6.9078 * T / max(1.0e-4, x));

// Linear-in-dB-ish gain per sample after `x` seconds -> the same thing seen
// as a feedback pole. Used by resonators and waveguide loops.
pole(x) = 1.0 - rate(x);

// MIDI-ish helpers that stay out of libm: semitone ratio from a table-free
// polynomial would be wrong over a wide range, so pitch ratios are given as
// explicit constants by the instruments that need them, and `cents` is only
// for the small detunes (|c| < 100) where 1 + c*0.000578 is within 0.001%.
cents(c) = 1.0 + c * 0.00057762;

// ── phase and oscillators ──────────────────────────────────────────────
// A [0,1) phase, one add and one compare per sample. `f` in Hz, f < SR.
phasor(f) = (+(f * T) : wrap) ~ _ with { wrap(x) = x - (x >= 1.0); };

// Wrap any real into [0,1) — for phase MODULATION, where the sum can be
// negative or several turns out.
wrap01(x) = y + (y < 0.0) with { y = x - int(x); };

// sin(2*pi*p) for p in [0,1). Parabola + 0.225 correction.
psin(p) = y + 0.225 * (y * abs(y) - y)
with {
    t = 2.0 * p - 1.0;
    y = -4.0 * t * (1.0 - abs(t));
};

sine(f) = psin(phasor(f));
sine_pm(f, pm) = psin(wrap01(phasor(f) + pm));

// A phasor that restarts at 0 on `trg` (a one-sample pulse): a drum's body
// must start at the same phase every hit or the click differs hit to hit.
phasor_r(f, trg) = (+(f * T) : wrap : *(1.0 - trg)) ~ _ with { wrap(x) = x - (x >= 1.0); };

tri(f) = 4.0 * abs(phasor(f) - 0.5) - 1.0;

// PolyBLEP residual: the two-sample correction that turns a naive step into a
// band-limited one. p = phase [0,1), dt = f/SR.
blep(p, dt) = lo + hi
with {
    x1 = p / dt;
    x2 = (p - 1.0) / dt;
    lo = (p < dt) * (x1 + x1 - x1 * x1 - 1.0);
    hi = (p > 1.0 - dt) * (x2 * x2 + x2 + x2 + 1.0);
};

saw_p(p, dt) = 2.0 * p - 1.0 - blep(p, dt);
saw(f) = saw_p(phasor(f), f * T);

// Pulse of width w (0..1) as the difference of two band-limited saws.
pulse_p(p, dt, w) = saw_p(p, dt) - saw_p(wrap01(p + w), dt);
pulse(f, w) = pulse_p(phasor(f), f * T, w);

// Hard square, band-limited, for the chip voices.
square(f) = pulse(f, 0.5);

// ── nonlinearities ─────────────────────────────────────────────────────
// Cubic soft clip: unity slope at 0, flat at +-1, continuous first derivative.
soft(x) = k * (1.5 - 0.5 * k * k) with { k = max(-1.0, min(1.0, x)); };

// Odd, bounded, tanh-like: Pade [3/2]. Division, so use sparingly on a live
// voice; soft() is the cheap one.
tnh(x) = k * (27.0 + k * k) / (27.0 + 9.0 * k * k)
with { k = max(-3.0, min(3.0, x)); };

dcblock = fi.dcblocker;

// ── filters ────────────────────────────────────────────────────────────
// tan(pi*fc/SR) without libm. fc is clamped to 0.25*SR.
tanx(fc) = x * (1.0 + x2 * (0.333333 + x2 * (0.133333 + x2 * 0.053968)))
with {
    x = 3.14159265 * min(fc, 0.25 * ma.SR) * T;
    x2 = x * x;
};

// Topology-preserving state-variable filter (Zavalishin / Cytomic form).
// svf(fc, q, x) -> lp, bp, hp.  q is resonance in [0.5, ~20].
svf(fc, q, x) = x : (core ~ (_, _)) : !, !, _, _, _
with {
    g = tanx(fc);
    k = 1.0 / q;
    a1 = 1.0 / (1.0 + g * (g + k));
    a2 = g * a1;
    a3 = g * a2;
    core(ic1, ic2, v0) = 2.0 * v1 - ic1, 2.0 * v2 - ic2, v2, v1, hp
    with {
        v3 = v0 - ic2;
        v1 = a1 * ic1 + a2 * v3;
        v2 = ic2 + a2 * ic1 + a3 * v3;
        hp = v0 - k * v1 - v2;
    };
};

lp(fc, q) = svf(fc, q) : _, !, !;
bp(fc, q) = svf(fc, q) : !, _, !;
hp(fc, q) = svf(fc, q) : !, !, _;

// One-pole lowpass at fc Hz: cheap tone control. fc < 0.25*SR.
lp1(fc) = *(a) : + ~ *(1.0 - a) with { a = min(1.0, 6.2832 * fc * T); };

// First-order allpass, coefficient a in (-1,1). Group delay at DC is
// (1-a)/(1+a) samples, which is what lets it tune a waveguide loop to a
// fractional length.
ap1(a) = (+ ~ *(-a)) <: (*(a), mem) :> +;

// ── envelopes ──────────────────────────────────────────────────────────
// All envelopes are one-pole chases toward a target, never an exp() call.
// A time argument is "seconds to settle" and is meant loosely: the point of
// a one-pole is the curve's SHAPE (fast then slow, no corner), which is what
// an ear reads as natural, not its exact duration.

// Rising edge of a gate, one sample long.
edge(g) = (g > 0.5) * (g' <= 0.5);

// Exponential decay to -60 dB in `t` seconds, restarted to 1 by `trg`.
decay(t, trg) = body ~ _ with { body(p) = max(trg, p * pole(t)); };

// ADSR on a gate. a: time to ~99%, d: settle toward sustain, s: sustain
// level, r: settle to silence. `a` = 0 is an instant jump (a click).
adsr(a, d, s, r, g) = env ~ _
with {
    on = g > 0.5;
    t = (+(1.0) : min(1.0e7) : *(on)) ~ _;
    atk = on * (t <= a * ma.SR);
    dec = on - atk;
    target = atk + dec * s;
    rt = atk * rate(a * 1.5) + dec * rate(d) + (1.0 - on) * rate(r);
    env(p) = p + rt * (target - p);
};

// Percussive amplitude: exact restart on the rising edge, falls on its own,
// ignores gate release.
perc(t, g) = decay(t, edge(g));

// ── smoothing ──────────────────────────────────────────────────────────
// Zipper-free parameter: one-pole lag with a `t` second settle.
lag(t) = *(rate(t)) : + ~ *(1.0 - rate(t));

// ── resonators, for the modal instruments ──────────────────────────────
// cos and sin of 2*pi*f/SR, for f < 0.5*SR.
cosw(f) = psin(f * T + 0.25);
sinw(f) = psin(f * T);

// Two-pole resonator on an arbitrary input: y = x + c1*y' + c2*y''.
res2(c1, c2) = + ~ (_ <: *(c1), (mem : *(c2)) :> _);

// One vibrating mode: frequency f (Hz), time-to-silence t (s), peak amp a.
// Scaled by sin(theta) so a low mode and a high mode struck by the same
// impulse come out at the amplitude asked for, not 1/sin(theta) apart.
// Modes at or above 0.45*SR are muted rather than allowed to alias.
mode(f, t, a) = *(a * sinw(f) * (f < 0.45 * ma.SR)) : res2(c1, c2)
with {
    r = pole(t);
    c1 = 2.0 * r * cosw(f);
    c2 = -r * r;
};

// A strike: the impulse a gate edge makes, softened by a one-pole whose
// corner is `bright` Hz. Hard mallet = high corner, felt = low.
strike(bright, g) = edge(g) : lp1(bright);

// ── noise ──────────────────────────────────────────────────────────────
// no.noise is a 32-bit integer LCG: no libm, and the same stream on every
// architecture, which is what lets a baked render be reproduced.
noise = no.noise;

// One period of noise from a gate edge, for plucks. `f` in Hz.
burst(f, g) = no.noise * (ba.countdown(ma.SR / f, edge(g)) > 0.0);

// ── space ──────────────────────────────────────────────────────────────
// Mono -> stereo by a short delay on one side (Haas), collapsing harmlessly
// on a single speaker. ms <= 10.
haas(ms) = _ <: _, de.delay(512, int(ms * 0.001 * ma.SR));

// Dry + one modulated tap, mono -> mono. `depth` in ms, `r` in Hz.
chorus(depth, r) = _ <: _, de.fdelay(2048, (6.0 + depth * (0.5 + 0.5 * sine(r))) * 0.001 * ma.SR) :> *(0.5);

// ── strings ────────────────────────────────────────────────────────────
// The extended Karplus-Strong loop: a delay, a first-order allpass that tunes
// the loop to a FRACTIONAL length, and a two-point lowpass that is the string's
// frequency-dependent loss. Plain Karplus-Strong only plays the pitches whose
// period is a whole number of samples, which at 32 kHz is audibly out of tune
// above ~600 Hz; the allpass is what the old ks.dsp's `pm.f2l` was doing for it.
//
//   f     fundamental, Hz (>= 20 at 32 kHz; the line is 2048 samples)
//   t60   seconds for the loop to fall 60 dB
//   damp  0 = no loss filter (ringing, bright)  1 = strongest (dull, short)
//   exc   the excitation, as the first input
//
// Loop delay budget:  1 (the `~`)  +  n (the line)  +  d_ap (the allpass)
//                     +  c (the lowpass's DC group delay)   =  SR/f
string(f, t60, damp) = (+ : de.delay(2048, n) : ap1(a) : lpf) ~ *(g)
with {
    c = 0.5 * damp;
    tgt = ma.SR / f - 1.0 - c;
    n = int(tgt - 0.5);
    dap = tgt - n;
    a = (1.0 - dap) / (1.0 + dap);
    g = min(0.9995, 1.0 - 6.9078 / max(1.0, f * t60));
    lpf(x) = (1.0 - c) * x + c * x';
};

// ── modal banks ────────────────────────────────────────────────────────
// A struck bar, bell or plate as a sum of decaying sinusoids. `rs` are the
// partial ratios to f, `ts` their ring-out times, `as` their amplitudes —
// three literal lists of the same length, and `k` scales every ring-out time
// at once (see tscale). The excitation is the first input.
modes(f, k, rs, ts, as) = _ <: par(i, N, mode(f * ba.take(i + 1, rs), k * ba.take(i + 1, ts), ba.take(i + 1, as))) :> _
with { N = ba.count(rs); };

// Higher notes of a struck instrument ring for less time. 1.0 at 220 Hz,
// 0.5 at 660 Hz, 2.0 at 0 Hz: a smooth curve with no pow().
tscale(f) = 2.0 / (1.0 + f * 0.0045454);

// ── retro: the sound of cheap hardware ─────────────────────────────────
// Everything above is written to be CLEAN. The 8- and 16-bit voices want the
// opposite, and want it cheaply: a naive pulse (one compare, aliasing and all —
// the aliasing IS the sound of a NES), a quantiser that throws away bits, and a
// sample-and-hold that throws away rate. Each is a handful of instructions,
// which is why a chip voice is the cheapest live instrument in the library.

// Naive pulse, duty d in (0,1): no band-limiting, deliberately.
npulse(f, d) = (phasor(f) < d) * 2.0 - 1.0;

// Sample-and-hold at r Hz: a converter running at a lower rate than the system
// (the DMX sound effects are 11 kHz; a SNES voice is 32 kHz through a filter).
hold(r) = ba.sAndH(trg) with { p = phasor(r); trg = p < p'; };

// Throw away bits: `levels` steps per unit (16 = a 4-bit-ish grid, 128 = 8-bit).
quant(levels) = *(levels) : int : *(1.0 / levels);

// Rate and depth together: the lo-fi converter.
lofi(r, levels) = hold(r) : quant(levels);

// One-bit noise at a clock rate: the NES noise channel's LFSR, as far as the ear
// can tell (a period-32767 shift register and a held coin flip are not
// distinguishable on a drum).
bitnoise(r) = (no.noise > 0.0) * 2.0 - 1.0 : hold(r);

// NES triangle: a 4-bit triangle, 32 steps per cycle.
tri4(f) = (4.0 * abs(phasor(f) - 0.5) - 1.0) : quant(8.0);

// OPL2 operator waveforms. w: 0 sine, 1 half-sine, 2 abs-sine, 3 pulse-sine
// (the first quarter of each half cycle). p in [0,1).
opl(w, p) = ba.selectn(4, int(w), s, max(0.0, s), abs(s), abs(s) * (q < 0.5))
with {
    s = psin(p);
    q = p * 2.0 - int(p * 2.0);
};

// A two-operator FM voice in the manner of the Yamaha OPL2 (AdLib, Sound
// Blaster, and so every PC game of 1993 including DOOM): a modulator at
// f * mm, with feedback `fb` (0..1, its own output averaged over two samples —
// the OPL2's one trick), phase-modulating a carrier at f * cm. `mi` is the
// modulation index in TURNS, already enveloped; mw and cw pick the waveforms.
opl2(f, mm, cm, mi, fb, mw, cw) = opl(cw, wrap01(phasor(f * cm) + mi * mod))
with {
    mod = ((_ <: _, mem :> +) : *(0.5 * fb) : +(phasor(f * mm)) : wrap01 : opl(mw)) ~ _;
};
